rules_version = '2';

// Max Silver portal.
//   users/{uid}      role (see below), name, phone, code, regions[], cities, active
//   invoices/{uid}_{docNo}   one saved proforma per document, owned by the specialist who issued it
//   prices/{uid}     remembered unit prices of one specialist
// Nobody is let in until a users/{uid} document exists for their account.
//
// Roles (assets/roles.js carries the same table for the interface; keep the two in step):
//   manager          general management and development (the legacy value 'it' is the same role)
//   ceo              CEO and board: approves roles, rates and results; sees every proforma
//   sales_manager    sees every proforma and the team; edits provinces and cities of specialists; reviews commission
//   visitor          regional sales specialist: own proformas, own profile and own region's approved commission only
//   account_manager  sees every proforma (order and settlement control)
//   finance          finance and accounting (the legacy value 'accounting' is the same role): enters commission rates, sees every proforma
//   operations, production, service, marketing, hr
//                    no proforma access; hr edits name, phone and the active flag
// Only manager and ceo create accounts or change role and code. Nobody may change their own role.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('active', true) != false;
    }
    // two values were merged into other roles; accounts that still carry them behave as the merged role
    function rawRole() { return profile().get('role', 'visitor'); }
    function role() { return rawRole() == 'it' ? 'manager' : (rawRole() == 'accounting' ? 'finance' : rawRole()); }
    function hasRole(list) { return approved() && role() in list; }

    function isManager() { return hasRole(['manager', 'ceo']); }                                   // delete proformas, approve
    function seesAllInvoices() { return hasRole(['manager', 'ceo', 'sales_manager', 'account_manager', 'finance']); }
    function seesTeam() { return hasRole(['manager', 'ceo', 'sales_manager', 'hr']); }
    function adminsRoles() { return hasRole(['manager', 'ceo']); }                                 // create, delete, role, code
    function editsPeople() { return hasRole(['hr']); }                                             // name, phone, active
    function editsTerritory() { return hasRole(['sales_manager']); }                               // regions, cities

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || seesTeam());
      allow create: if adminsRoles();
      // nobody removes their own account; hr removes accounts but never those of management or the CEO
      allow delete: if request.auth.uid != uid
        && (adminsRoles() || (editsPeople() && !(resource.data.get('role', 'visitor') in ['manager', 'ceo', 'it'])));
      allow update: if adminsRoles()
        || (editsPeople() && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'active']))
        || (editsTerritory()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['regions', 'cities', 'commissionRegions']))
        // anyone may edit only their own display name, phone and sign-in e-mail (which must be the one they signed in with);
        // role, code, regions and active stay with the roles above
        || (approved() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'email'])
            && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
            && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)));
    }

    match /invoices/{id} {
      allow read: if approved() && (resource.data.ownerUid == request.auth.uid || seesAllInvoices());
      allow create: if approved()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.docNo is string
        && id == request.auth.uid + '_' + request.resource.data.docNo
        && request.resource.data.lines is list
        && request.resource.data.lines.size() <= 200;
      allow update: if approved()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.docNo == resource.data.docNo
        && request.resource.data.lines is list
        && request.resource.data.lines.size() <= 200;
      allow delete: if approved() && (resource.data.ownerUid == request.auth.uid || isManager());
    }

    // Commission: rates per region and year. Finance drafts, the sales manager marks them reviewed, the CEO approves and
    // publishes one result document per region. Nobody who earns commission can read the rate table; a specialist reads
    // only the approved result of the regions listed in their own users/{uid}.commissionRegions.
    function commissionReaders() { return hasRole(['manager', 'ceo', 'sales_manager', 'finance']); }

    match /commission_rates/{year} {
      allow read: if commissionReaders();
      allow create: if hasRole(['finance']) && request.resource.data.status == 'draft';
      allow update: if
        (hasRole(['finance']) && resource.data.status != 'approved' && request.resource.data.status == 'draft')
        || (hasRole(['sales_manager']) && resource.data.status == 'draft' && request.resource.data.status == 'reviewed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']))
        || (isManager() && resource.data.status == 'reviewed' && request.resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt']));
      allow delete: if false;
    }

    match /commission_results/{id} {
      allow read: if commissionReaders()
        || (approved() && resource.data.status == 'approved' && resource.data.region in profile().get('commissionRegions', []));
      allow create, update: if isManager() && request.resource.data.status == 'approved';
      allow delete: if false;
    }

    // Monthly base: one document per year and month holding the six regions' sales and rate; same three-step approval.
    match /commission_months/{id} {
      allow read: if commissionReaders();
      allow create: if hasRole(['finance']) && request.resource.data.status == 'draft';
      allow update: if
        (hasRole(['finance']) && resource.data.status != 'approved' && request.resource.data.status == 'draft')
        || (hasRole(['sales_manager']) && resource.data.status == 'draft' && request.resource.data.status == 'reviewed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']))
        || (isManager() && resource.data.status == 'reviewed' && request.resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt']));
      allow delete: if false;
    }

    match /commission_month_results/{id} {
      allow read: if commissionReaders()
        || (approved() && resource.data.status == 'approved' && resource.data.region in profile().get('commissionRegions', []));
      allow create, update: if isManager() && request.resource.data.status == 'approved';
      allow delete: if false;
    }

    // Tickets: a conversation. Every ticket carries an audience list such as ['uid:<sender>', 'role:finance'] or
    // ['uid:<sender>', 'uid:<person>']; members of the audience and general management read it. Messages are immutable.
    function inAudience(aud) { return ('uid:' + request.auth.uid) in aud || ('role:' + role()) in aud; }

    match /tickets/{id} {
      allow read: if approved() && (inAudience(resource.data.audience) || hasRole(['manager']));
      allow create: if approved()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.audience is list && request.resource.data.audience.size() <= 3
        && ('uid:' + request.auth.uid) in request.resource.data.audience;
      allow update: if (approved() && (inAudience(resource.data.audience) || hasRole(['manager']))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastText', 'lastBy', 'lastByName']))
        // delivery receipts: a member of the conversation records only their own "received" and "seen" times
        || (approved() && inAudience(resource.data.audience)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recv_' + request.auth.uid, 'read_' + request.auth.uid]));
      allow delete: if false;

      match /messages/{mid} {
        allow read: if approved() && (inAudience(get(/databases/$(database)/documents/tickets/$(id)).data.audience) || hasRole(['manager']));
        // getAfter: the first message is written in the same batch as the ticket itself
        allow create: if approved()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && (inAudience(getAfter(/databases/$(database)/documents/tickets/$(id)).data.audience) || hasRole(['manager']));
        allow update, delete: if false;
      }
    }

    // Messages from people without an account (contact form on the home page and the panel). Anyone may write one, only the
    // addressee role reads and closes it. Three contact points exist: sales, service and management.
    function readsPublic(to) {
      return hasRole(['manager', 'ceo']) || (to == 'sales' && hasRole(['sales_manager'])) || (to == 'service' && hasRole(['service']));
    }

    match /public_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'to', 'text', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.contact is string && request.resource.data.contact.size() >= 3 && request.resource.data.contact.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.to in ['sales', 'service', 'management']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is number;
      allow read: if approved() && readsPublic(resource.data.to);
      allow update: if approved() && readsPublic(resource.data.to)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // How a person wants to be told: none, push, email or both, and the address for email. Readable by people of the company
    // (the sender's browser needs it to send the mail); only the owner writes it.
    match /notify_prefs/{uid} {
      allow read: if approved();
      allow create, update: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'name', 'channels', 'email', 'updatedAt'])
        && request.resource.data.channels in ['none', 'push', 'email', 'both']
        && request.resource.data.email is string && request.resource.data.email.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if false;
    }

    match /prices/{uid} {
      allow read, write: if approved() && request.auth.uid == uid;
    }
  }
}
