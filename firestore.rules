rules_version = '2';

// Max Silver portal.
//   users/{uid}      role (see below), name, phone, code, regions[], cities, active
//   invoices/{uid}_{docNo}   one saved proforma per document, owned by the specialist who issued it
//   prices/{uid}     remembered unit prices of one specialist
// Nobody is let in until a users/{uid} document exists for their account.
//
// Roles (assets/roles.js carries the same table for the interface; keep the two in step):
//   manager          general management and development (the legacy value 'it' is the same role)
//   ceo              CEO and board: approves roles, rates and results; sees every proforma
//   sales_manager    sees every proforma and the team; edits provinces and cities of specialists; reviews commission
//   visitor          regional sales specialist: own proformas, own profile and own region's approved commission only
//   account_manager  sees every proforma and customer (order and settlement control); reviews proformas
//   finance          finance and accounting (the legacy value 'accounting' is the same role): enters commission rates, sees every proforma
//   operations, production, service, marketing, hr
//                    no proforma access; hr edits name, phone and the active flag
// Only manager and ceo create accounts or change role and code. Nobody may change their own role.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('active', true) != false;
    }
    // two values were merged into other roles; accounts that still carry them behave as the merged role
    function rawRole() { return profile().get('role', 'visitor'); }
    function role() { return rawRole() == 'it' ? 'manager' : (rawRole() == 'accounting' ? 'finance' : rawRole()); }
    function hasRole(list) { return approved() && role() in list; }

    // Authority to load or replace data. The owner (manager) always has it; he can also name people per task in settings/permissions
    // (roadmapEdit, competitorsEdit, warehouseEdit). A task he has not configured keeps the roles listed in the rule.
    function permSet() { return exists(/databases/$(database)/documents/settings/permissions); }
    function permDoc() { return get(/databases/$(database)/documents/settings/permissions).data; }
    function granted(cap, fallbackRoles) {
      return hasRole(['manager'])
        || (approved() && permSet() && cap in permDoc() && request.auth.uid in permDoc()[cap])
        || ((!permSet() || !(cap in permDoc())) && hasRole(fallbackRoles));
    }
    function isManager() { return hasRole(['manager', 'ceo']); }                                   // delete proformas, approve
    function seesAllInvoices() { return hasRole(['manager', 'ceo', 'sales_manager', 'account_manager', 'finance']); }
    function seesTeam() { return hasRole(['manager', 'ceo', 'sales_manager', 'hr']); }
    // Only organizational technology (the manager role, the owner of the system) gives anyone authority: accounts, roles, codes, the price editors and every data file that is loaded or replaced.
    function adminsRoles() { return hasRole(['manager']); }                                        // create, delete, role, code
    function editsPeople() { return hasRole(['hr']); }                                             // name, phone, active
    function editsTerritory() { return hasRole(['sales_manager']); }                               // regions, cities

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || seesTeam());
      allow create: if adminsRoles();
      // nobody removes their own account; hr removes accounts but never those of management or the CEO
      allow delete: if request.auth.uid != uid
        && (adminsRoles() || (editsPeople() && !(resource.data.get('role', 'visitor') in ['manager', 'ceo', 'it'])));
      allow update: if adminsRoles()
        || (editsPeople() && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'active']))
        || (editsTerritory()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['regions', 'cities', 'commissionRegions']))
        // anyone may edit only their own contact e-mail (and record the sign-in e-mail they signed in with);
        // name, phone, role, code, regions and active stay with the roles above
        || (approved() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'contactEmail'])
            && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
            && (!('contactEmail' in request.resource.data) || (request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 80)));
    }

    // National id: one private card per person. The person reads it; hr and management write it. The team list never carries it.
    match /personal/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || adminsRoles() || editsPeople());
      allow create, update: if (adminsRoles() || editsPeople())
        && request.resource.data.keys().hasOnly(['nationalId', 'birthday', 'updatedAt'])
        && request.resource.data.nationalId is string
        && (request.resource.data.nationalId == '' || request.resource.data.nationalId.matches('^[0-9]{10}$'))
        && (!('birthday' in request.resource.data) || request.resource.data.birthday == '' || request.resource.data.birthday.matches('^[0-9]{4}/[0-9]{2}/[0-9]{2}$'));
      allow delete: if adminsRoles() || editsPeople();
    }

    // A proforma. The owner writes it; the account manager approves or refuses it (only the `review` field); a refusal is decided
    // by the sales manager or management: declining keeps the proforma, accepting moves it to invoice_archive and deletes it here.
    match /invoices/{id} {
      allow read: if approved() && (id.matches(request.auth.uid + '_.*') || resource.data.ownerUid == request.auth.uid || seesAllInvoices());
      allow create: if approved() && !hasRole(['hr'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.docNo is string
        && id == request.auth.uid + '_' + request.resource.data.docNo
        && request.resource.data.lines is list
        && request.resource.data.lines.size() <= 200;
      allow update: if approved() && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.docNo == resource.data.docNo
          && request.resource.data.lines is list
          && request.resource.data.lines.size() <= 200
          && request.resource.data.get('review', null) == resource.data.get('review', null))
        || (hasRole(['account_manager'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'updatedAt'])
          && request.resource.data.review.status in ['approved', 'refusal']
          && request.resource.data.review.by == request.auth.uid)
        || (hasRole(['sales_manager', 'manager', 'ceo'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'updatedAt'])
          && resource.data.get('review', {}).get('status', '') == 'refusal'
          && request.resource.data.review.status == 'kept')
        // finance chooses which bank account the customer's copy shows (only after the account manager approved the pre-invoice)
        || (hasRole(['finance', 'account_manager'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bankId', 'bank', 'updatedAt'])
          && resource.data.get('review', {}).get('status', '') == 'approved'));
      allow delete: if approved() && (resource.data.ownerUid == request.auth.uid || isManager()
        || (hasRole(['sales_manager']) && resource.data.get('review', {}).get('status', '') == 'refusal'));
    }

    // Customers: one record per accounting code. People who manage customers read all of them; everyone else reads only the
    // customers whose ownerUid is theirs. The import and the owner assignment belong to management and the sales manager.
    function seesAllCustomers() { return hasRole(['manager', 'ceo', 'sales_manager', 'account_manager', 'finance']); }
    function ownsCustomer() { return approved() && resource.data.get('ownerUid', '') == request.auth.uid; }
    match /customers/{code} {
      allow read: if seesAllCustomers() || ownsCustomer();
      allow delete: if hasRole(['manager', 'ceo', 'sales_manager']);
      // the account manager opens the profile of a customer who is new (from a pre-invoice); the leads create any
      allow create: if hasRole(['manager', 'ceo', 'sales_manager'])
        || (hasRole(['account_manager'])
            && request.resource.data.keys().hasOnly(['code', 'name', 'city', 'province', 'region', 'group', 'phone', 'address', 'contact', 'notes', 'postal', 'nationalId', 'birthday', 'createdFrom', 'createdAt', 'updatedAt'])
            && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
            && request.resource.data.code is string && request.resource.data.code.size() >= 1 && request.resource.data.code.size() <= 40);
      allow update: if hasRole(['manager', 'ceo', 'sales_manager'])
        || ((hasRole(['account_manager']) || ownsCustomer())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address', 'contact', 'notes', 'postal', 'nationalId', 'birthday', 'updatedAt'])
            && (!('postal' in request.resource.data) || request.resource.data.postal == '' || request.resource.data.postal.matches('^[0-9]{10}$'))
            && (!('nationalId' in request.resource.data) || request.resource.data.nationalId == '' || request.resource.data.nationalId.matches('^[0-9]{10}$'))
            && (!('birthday' in request.resource.data) || request.resource.data.birthday == '' || request.resource.data.birthday.matches('^[0-9]{4}/[0-9]{2}/[0-9]{2}$')));
    }
    // Catalogue files page: the roles that present products read; management writes. The files are uploaded to the server endpoint.
    match /catalogues/{id} {
      allow read: if hasRole(['manager', 'ceo', 'sales_manager', 'visitor', 'account_manager', 'marketing']);
      allow delete: if hasRole(['manager']);
      allow create, update: if hasRole(['manager'])
        && request.resource.data.keys().hasOnly(['title', 'about', 'files', 'active', 'order', 'cover', 'updatedAt', 'updatedBy'])
        && (!('cover' in request.resource.data) || (request.resource.data.cover is string && request.resource.data.cover.size() <= 80000))
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 120
        && request.resource.data.files is list && request.resource.data.files.size() <= 30;
    }
    // Staff and applicants with salaries: human resources and management only (not even to read for anyone else).
    match /staff/{id} {
      allow read: if hasRole(['manager', 'ceo', 'hr']);
      allow delete: if hasRole(['manager', 'hr']);
      allow create, update: if hasRole(['manager', 'ceo', 'hr'])
        && request.resource.data.keys().hasOnly(['name', 'unit', 'position', 'phone', 'code', 'status', 'startDate', 'endDate', 'salary', 'salaryNote', 'nationalId', 'birthday', 'education', 'address', 'email', 'stage', 'notes', 'photo', 'importedAt', 'updatedAt', 'updatedBy'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 80000))
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.get('status', 'active') in ['active', 'left', 'applicant']
        && (!('salary' in request.resource.data) || (request.resource.data.salary is number && request.resource.data.salary >= 0));
    }
    // A customer group is a responsible partner or person; the owner is applied to the group's customers.
    match /customer_groups/{id} {
      allow read: if seesAllCustomers();
      allow create, update: if hasRole(['manager', 'ceo', 'sales_manager']);
      allow delete: if false;
    }

    // Refused proformas kept for the record (written when the sales manager accepts a refusal). Nobody edits or deletes them.
    match /invoice_archive/{id} {
      allow read: if approved() && (resource.data.ownerUid == request.auth.uid || seesAllInvoices());
      allow create: if hasRole(['sales_manager', 'manager', 'ceo']) && request.resource.data.status == 'refused'
        && request.resource.data.ownerUid is string && request.resource.data.docNo is string;
      allow update, delete: if false;
    }

    // Commission: rates per region and year. Finance drafts, the sales manager marks them reviewed, the CEO approves and
    // publishes one result document per region. Nobody who earns commission can read the rate table; a specialist reads
    // only the approved result of the regions listed in their own users/{uid}.commissionRegions.
    function commissionReaders() { return hasRole(['manager', 'ceo', 'sales_manager', 'finance']); }

    match /commission_rates/{year} {
      allow read: if commissionReaders();
      allow create: if hasRole(['finance']) && request.resource.data.status == 'draft';
      allow update: if
        (hasRole(['finance']) && resource.data.status != 'approved' && request.resource.data.status == 'draft')
        || (hasRole(['sales_manager']) && resource.data.status == 'draft' && request.resource.data.status == 'reviewed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']))
        || (isManager() && resource.data.status == 'reviewed' && request.resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt']));
      allow delete: if false;
    }

    match /commission_results/{id} {
      allow read: if commissionReaders()
        || (approved() && resource.data.status == 'approved' && resource.data.region in profile().get('commissionRegions', []));
      allow create, update: if isManager() && request.resource.data.status == 'approved';
      allow delete: if false;
    }

    // Monthly base: one document per year and month holding the six regions' sales and rate; same three-step approval.
    match /commission_months/{id} {
      allow read: if commissionReaders();
      allow create: if hasRole(['finance']) && request.resource.data.status == 'draft';
      allow update: if
        (hasRole(['finance']) && resource.data.status != 'approved' && request.resource.data.status == 'draft')
        || (hasRole(['sales_manager']) && resource.data.status == 'draft' && request.resource.data.status == 'reviewed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']))
        || (isManager() && resource.data.status == 'reviewed' && request.resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt']));
      allow delete: if false;
    }

    match /commission_month_results/{id} {
      allow read: if commissionReaders()
        || (approved() && resource.data.status == 'approved' && resource.data.region in profile().get('commissionRegions', []));
      allow create, update: if isManager() && request.resource.data.status == 'approved';
      allow delete: if false;
    }

    // Tickets: a conversation. Every ticket carries an audience list such as ['uid:<sender>', 'role:finance'] or
    // ['uid:<sender>', 'uid:<person>']; members of the audience and general management read it. Messages are immutable.
    function inAudience(aud) { return ('uid:' + request.auth.uid) in aud || ('role:' + role()) in aud; }

    match /tickets/{id} {
      allow read: if approved() && (inAudience(resource.data.audience) || hasRole(['manager']));
      allow create: if approved()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.audience is list && request.resource.data.audience.size() <= 3
        && ('uid:' + request.auth.uid) in request.resource.data.audience;
      allow update: if (approved() && (inAudience(resource.data.audience) || hasRole(['manager']))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastText', 'lastBy', 'lastByName']))
        // delivery receipts: a member of the conversation records only their own "received" and "seen" times
        || (approved() && inAudience(resource.data.audience)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recv_' + request.auth.uid, 'read_' + request.auth.uid]));
      allow delete: if false;

      match /messages/{mid} {
        allow read: if approved() && (inAudience(get(/databases/$(database)/documents/tickets/$(id)).data.audience) || hasRole(['manager']));
        // getAfter: the first message is written in the same batch as the ticket itself
        allow create: if approved()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && (inAudience(getAfter(/databases/$(database)/documents/tickets/$(id)).data.audience) || hasRole(['manager']));
        allow update, delete: if false;
      }
    }

    // Messages from people without an account (contact form on the home page and the panel). Anyone may write one, only the
    // addressee role reads and closes it. Three contact points exist: sales, service and management.
    function readsPublic(to) {
      return hasRole(['manager', 'ceo']) || (to == 'sales' && hasRole(['sales_manager'])) || (to == 'service' && hasRole(['service']));
    }

    match /public_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'to', 'text', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.contact is string && request.resource.data.contact.size() >= 3 && request.resource.data.contact.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.to in ['sales', 'service', 'management']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is number;
      allow read: if approved() && readsPublic(resource.data.to);
      allow update: if approved() && readsPublic(resource.data.to)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // How a person wants to be told: push (default) or none. Readable by people of the company; only the owner writes it.
    match /notify_prefs/{uid} {
      allow read: if approved();
      allow create, update: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'name', 'channels', 'email', 'updatedAt'])
        && request.resource.data.channels in ['none', 'push']
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 80))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if false;
    }

    // Presence: a heartbeat and a typing signal, written by the person only, readable by people of the company.
    match /presence/{uid} {
      allow read: if approved();
      allow create, update: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online', 'lastSeen', 'typingIn', 'typingAt'])
        && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen is number)
        && (!('typingAt' in request.resource.data) || request.resource.data.typingAt is number)
        && (!('typingIn' in request.resource.data) || (request.resource.data.typingIn is string && request.resource.data.typingIn.size() <= 40));
      allow delete: if false;
    }

    // A person's look: a colour from the palette and an optional small picture (a data URL cut to 192 px). People of the
    // company read it so conversations can show faces; only the owner writes it.
    match /profiles/{uid} {
      allow read: if approved();
      allow create, update: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'color', 'photo', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.color is string && request.resource.data.color.size() <= 9
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 45000;
      allow delete: if false;
    }

    // list prices of the catalog (toman). Anyone approved reads; sales management, management and organizational technology edit.
    // «s»: p = price, i = ask for a quote, r = being restocked. Deleting an edit brings the price list file back.
    // Prices and the code status can be changed only by the people named in settings/price_editors (at most two), and only while they still
    // hold a pricing role. Management and the CEO name them; until two are named nobody changes prices.
    function priceEditor() {
      return hasRole(['manager', 'ceo', 'sales_manager'])
        && exists(/databases/$(database)/documents/settings/price_editors)
        && request.auth.uid in get(/databases/$(database)/documents/settings/price_editors).data.uids;
    }
    match /settings/{id} {
      allow read: if approved();
      allow create, update: if hasRole(['manager']) && id == 'price_editors'
        && request.resource.data.keys().hasOnly(['uids', 'names', 'at', 'by', 'byName'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 2
        && request.resource.data.by == request.auth.uid;
      allow create, update: if hasRole(['manager']) && id == 'permissions'
        && request.resource.data.keys().hasOnly(['roadmapEdit', 'competitorsEdit', 'warehouseEdit', 'names', 'at', 'by', 'byName'])
        && request.resource.data.by == request.auth.uid;
      // the cheque price is the cash price plus a percentage (default and per product group); the same two people set it
      allow create, update: if priceEditor() && id == 'cheque_markup'
        && request.resource.data.keys().hasOnly(['def', 'byGrp', 'at', 'by', 'byName'])
        && request.resource.data.def is number && request.resource.data.def >= 0 && request.resource.data.def <= 100
        && request.resource.data.byGrp is map && request.resource.data.by == request.auth.uid;
      allow delete: if false;
    }
    // one line per price change (product, before, after, who, when). Written by the price editors; never edited or deleted.
    match /price_log/{id} {
      allow read: if hasRole(['manager', 'ceo', 'sales_manager', 'finance']);   // the same roles that open the prices page
      allow create: if priceEditor()
        && request.resource.data.keys().hasOnly(['id', 'name', 'code', 'brand', 'old', 'oldS', 'p', 's', 'at', 'by', 'byName', 'src'])
        && request.resource.data.s in ['p', 'i', 'r', 'n']
        && request.resource.data.p is number && request.resource.data.p >= 0 && request.resource.data.p < 100000000000
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
    match /list_prices/{id} {
      allow read: if approved();
      allow create, update: if priceEditor()
        && request.resource.data.keys().hasOnly(['p', 's', 'at', 'by', 'byName', 'prev', 'c'])
        && request.resource.data.s in ['p', 'i', 'r', 'n']
        && (!('c' in request.resource.data) || (request.resource.data.c is number && request.resource.data.c >= 0 && request.resource.data.c < 100000000000))
        && request.resource.data.p is number && request.resource.data.p >= 0 && request.resource.data.p < 100000000000
        && request.resource.data.by == request.auth.uid;
      allow delete: if priceEditor();
    }

    // Purchase requests from the public planner (Chef Market sheet). A visitor with no account signs in anonymously for the
    // moment of sending and may only CREATE the document; nobody but sales reads it. status: new | contacted | quoted | won | lost.
    // route: call (needs a call first) | warehouse | production (sales says the request may go on). assignee = the salesperson's uid.
    function ten(s) { return s is string && s.matches('[0-9]{10}'); }
    function mobile(s) { return s is string && s.matches('09[0-9]{9}'); }
    function salesLead() { return hasRole(['manager', 'ceo', 'sales_manager']); }
    // the day's request number, taken by the visitor's browser in the same transaction as the request: CON-TEH-051025-001
    match /request_counters/{day} {
      allow read: if signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous' && day.matches('[0-9]{6}')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }
    match /requests/{id} {
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && id.matches('CON-[A-Z]{3}-[0-9]{6}-[0-9]{3,5}')
        && request.resource.data.keys().hasOnly(['code', 'createdAt', 'status', 'route', 'customer', 'receiver', 'lines', 'plan', 'note', 'terms', 'src'])
        && request.resource.data.code == id && request.resource.data.createdAt is number
        && request.resource.data.status == 'new' && request.resource.data.route == 'call'
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasOnly(['name', 'phone', 'nid', 'address', 'city', 'zip'])
        && request.resource.data.customer.name is string && request.resource.data.customer.name.size() >= 3 && request.resource.data.customer.name.size() <= 80
        && mobile(request.resource.data.customer.phone) && ten(request.resource.data.customer.nid) && ten(request.resource.data.customer.zip)
        && request.resource.data.customer.address is string && request.resource.data.customer.address.size() >= 5 && request.resource.data.customer.address.size() <= 300
        && request.resource.data.customer.city is string && request.resource.data.customer.city.size() >= 2 && request.resource.data.customer.city.size() <= 40
        && request.resource.data.receiver is map
        && request.resource.data.receiver.keys().hasOnly(['self', 'name', 'nid', 'phone'])
        && request.resource.data.receiver.self is bool
        && (request.resource.data.receiver.self == true
            || (request.resource.data.receiver.get('name', '').size() >= 3 && request.resource.data.receiver.get('name', '').size() <= 80
                && ten(request.resource.data.receiver.get('nid', '')) && mobile(request.resource.data.receiver.get('phone', ''))))
        && request.resource.data.lines is list && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 40
        && request.resource.data.plan is map
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.terms is string && request.resource.data.terms.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.src == 'planner';
      allow read: if salesLead() || hasRole(['account_manager']) || (hasRole(['visitor']) && resource.data.get('assignee', '') == request.auth.uid);
      allow update: if request.resource.data.status in ['new', 'contacted', 'quoted', 'won', 'lost']
        && request.resource.data.route in ['call', 'warehouse', 'production']
        && request.resource.data.get('stage', 'request') in ['request', 'confirmed', 'preinvoice', 'rejected', 'accepted', 'warehouse', 'production', 'ready', 'shipped', 'delivered', 'returned', 'cancelled']
        && request.resource.data.lines is list && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 40
        // stage: the specialist moves a request to «confirmed» and issues the pre-invoice (the app writes `preinvoice` and the numbers);
        // the account manager accepts, rejects and carries the order on; the sales manager and management may set any stage
        && ((salesLead()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'route', 'assignee', 'assigneeName', 'updatedAt', 'lastNote', 'stage', 'proformaNo', 'orderCode', 'proformaUid', 'rejectReason', 'lines']))
            || (hasRole(['visitor']) && resource.data.get('assignee', '') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'route', 'updatedAt', 'lastNote', 'stage', 'proformaNo', 'orderCode', 'proformaUid', 'lines'])
              && request.resource.data.get('stage', 'request') in ['request', 'confirmed', 'preinvoice', 'cancelled']
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lines']) || resource.data.get('stage', 'request') in ['request', 'confirmed']))
            || (hasRole(['account_manager'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['route', 'updatedAt', 'lastNote', 'stage', 'rejectReason'])
              && request.resource.data.get('stage', 'request') in ['accepted', 'rejected', 'warehouse', 'production', 'ready', 'shipped', 'delivered', 'returned', 'cancelled']));
      allow delete: if salesLead();   // management, the CEO and the sales manager
      // what was done on a request: calls, notes, decisions. Append only.
      match /log/{lid} {
        allow read: if salesLead() || hasRole(['account_manager']) || (hasRole(['visitor']) && get(/databases/$(database)/documents/requests/$(id)).data.get('assignee', '') == request.auth.uid);
        allow create: if (salesLead() || hasRole(['account_manager']) || (hasRole(['visitor']) && get(/databases/$(database)/documents/requests/$(id)).data.get('assignee', '') == request.auth.uid))
          && request.resource.data.keys().hasOnly(['at', 'by', 'byName', 'kind', 'text'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind in ['call', 'note', 'status', 'route', 'assign']
          && request.resource.data.text is string && request.resource.data.text.size() <= 400
          && request.resource.data.at is number;
        allow update, delete: if false;
      }
    }

    // read by everyone (no sign-in): which products are out of use, so the public planner does not offer them. Written by sales management.
    match /public_config/{id} {
      allow read: if true;
      allow create, update: if hasRole(['manager', 'ceo', 'sales_manager']) && id == 'retired'
        && request.resource.data.keys().hasOnly(['ids', 'at'])
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 500;
      // the switches that turn parts of the site on and off: only the technology lead (manager) writes them
      allow create, update: if hasRole(['manager']) && id == 'features'
        && request.resource.data.keys().hasOnly(['hidden', 'at', 'by'])
        && request.resource.data.hidden is map && request.resource.data.hidden.size() <= 40;
      allow delete: if false;
    }
    // product codes taken out of use (retired). Anyone approved reads; sales management, management and organizational technology write.
    // rep = id of the replacement product (may be empty). Deleting the document puts the product back in use.
    match /item_status/{id} {
      allow read: if approved();
      allow create, update: if priceEditor()
        && request.resource.data.keys().hasOnly(['rep', 'note', 'at', 'by', 'byName'])
        && request.resource.data.rep is string && request.resource.data.rep.size() <= 60
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.by == request.auth.uid;
      allow delete: if priceEditor();
    }

    // Job descriptions (شرح وظایف): one document per person. The person reads their own; hr, management and the CEO read and write
    // everyone's; the sales manager only those of salespeople. Nobody edits their own. Every edit appends a line to job_description_log
    // (the app also opens a ticket that carries the changes to the employee and to hr).
    function jdEditor(uid) {
      return hasRole(['manager', 'ceo', 'hr'])
        || (hasRole(['sales_manager']) && get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'visitor') == 'visitor');
    }
    match /job_descriptions/{uid} {
      allow read: if approved() && (request.auth.uid == uid || jdEditor(uid));
      allow create, update: if approved() && request.auth.uid != uid && jdEditor(uid)
        && request.resource.data.keys().hasOnly(['title', 'summary', 'duties', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 600
        && request.resource.data.duties is list && request.resource.data.duties.size() <= 40
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /job_description_log/{id} {
      allow read: if approved() && (resource.data.uid == request.auth.uid || jdEditor(resource.data.uid));
      allow create: if approved() && request.resource.data.uid != request.auth.uid && jdEditor(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'at', 'by', 'byName', 'changes'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.changes is list && request.resource.data.changes.size() >= 1 && request.resource.data.changes.size() <= 60
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // Texts the assistant may quote (company procedures, role descriptions): a person reads an entry only when their role is listed on it;
    // only organizational technology (manager) loads, replaces or deletes them.
    match /knowledge/{id} {
      allow read: if approved() && (hasRole(['manager', 'ceo']) || (resource.data.roles is list && role() in resource.data.roles));
      allow create, update: if approved() && hasRole(['manager'])
        && request.resource.data.keys().hasOnly(['title', 'body', 'tip', 'src', 'href', 'roles', 'draft', 'words', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 140
        && request.resource.data.body is list && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 120
        && request.resource.data.roles is list && request.resource.data.roles.size() >= 1 && request.resource.data.roles.size() <= 16;
      allow delete: if approved() && hasRole(['manager']);
    }

    // Questions the assistant could not answer: no name, only the role, so the team sees what to teach it next.
    match /arya_questions/{id} {
      allow read: if approved() && hasRole(['manager', 'ceo', 'sales_manager']);
      allow create: if approved() && request.resource.data.keys().hasOnly(['q', 'role', 'kind', 'at'])
        && request.resource.data.q is string && request.resource.data.q.size() >= 3 && request.resource.data.q.size() <= 200
        && request.resource.data.role == role() && request.resource.data.kind in ['none', 'down'] && request.resource.data.at is number;
      allow update: if false;
      allow delete: if approved() && hasRole(['manager']);
    }

    // Competitor analysis (sensitive, so it is not in the public repository): management, the CEO and the sales manager read it;
    // only organizational technology (manager) loads or replaces it; the roadmap is read-only for everyone else.
    match /intel/{id} {
      allow read: if hasRole(['manager', 'ceo', 'sales_manager']);
      allow create, update: if ((id == 'competitors' && granted('competitorsEdit', [])) || (id == 'roadmap' && granted('roadmapEdit', []))) && request.resource.data.title is string;
      allow delete: if false;
    }

    // Live inventory. The warehouse (operations) and management write stock; the account manager may only change `reserved` (a claim for
    // an order, always inside a transaction with a document in inventory_claims). Nobody can reserve more than is on hand.
    function stockReaders() { return hasRole(['operations', 'account_manager', 'manager', 'ceo', 'sales_manager', 'production']); }
    match /inventory/{pid} {
      allow read: if stockReaders();
      allow create, update: if (granted('warehouseEdit', ['operations', 'manager'])
          && request.resource.data.keys().hasOnly(['qty', 'reserved', 'loc', 'serials', 'note', 'updatedAt', 'updatedBy', 'updatedByName'])
          && request.resource.data.qty is number && request.resource.data.qty >= 0 && request.resource.data.qty <= 1000000
          && request.resource.data.reserved is number && request.resource.data.reserved >= 0 && request.resource.data.reserved <= request.resource.data.qty
          && request.resource.data.loc is string && request.resource.data.loc.size() <= 60
          && request.resource.data.serials is string && request.resource.data.serials.size() <= 2000)
        || (hasRole(['account_manager']) && resource != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reserved', 'updatedAt', 'updatedBy', 'updatedByName'])
          && request.resource.data.reserved is number && request.resource.data.reserved >= 0 && request.resource.data.reserved <= request.resource.data.qty);
      allow delete: if hasRole(['manager']);
    }
    match /inventory_claims/{cid} {
      allow read: if stockReaders();
      allow create: if hasRole(['account_manager'])
        && request.resource.data.keys().hasOnly(['pid', 'qty', 'ref', 'customer', 'note', 'status', 'at', 'by', 'byName'])
        && request.resource.data.qty is number && request.resource.data.qty > 0 && request.resource.data.qty <= 1000000
        && request.resource.data.status == 'active' && request.resource.data.by == request.auth.uid;
      allow update: if hasRole(['account_manager'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedAt'])
        && request.resource.data.status in ['released', 'shipped'];
      allow delete: if false;
    }

    // Bank accounts shown on pre-invoices (a brand's, the company's or a supplier's). Only the account manager adds, edits or removes them;
    // finance, management and the sales manager read them.
    match /bank_accounts/{id} {
      allow read: if hasRole(['account_manager', 'finance', 'manager', 'ceo', 'sales_manager']);
      allow create, update: if hasRole(['account_manager'])
        && request.resource.data.keys().hasOnly(['kind', 'brand', 'label', 'holder', 'bank', 'account', 'sheba', 'card', 'payee', 'note', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.kind in ['brand', 'company', 'supplier']
        && request.resource.data.label is string && request.resource.data.label.size() >= 2 && request.resource.data.label.size() <= 80
        && request.resource.data.holder is string && request.resource.data.holder.size() <= 80;
      allow delete: if hasRole(['account_manager']);
    }

    // Registry of pre-invoice numbers: a number belongs to the first person who pushed it and is never reused by anyone else. Nobody edits or deletes an entry.
    match /proforma_numbers/{no} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public tracking: request_status/<request code> holds only the stage and a time. Anyone who knows the code may read that one document
    // (no listing). The planner creates it with the request; staff keep it in step with the stage.
    match /request_status/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if code.matches('CON-[A-Z]{3}-[0-9]{6}-[0-9]{3,5}')
        && request.resource.data.keys().hasOnly(['stage', 'updatedAt']) && request.resource.data.updatedAt is number
        && ((signedIn() && request.resource.data.stage == 'request')
            || (hasRole(['manager', 'ceo', 'sales_manager', 'visitor', 'account_manager'])
                && request.resource.data.stage in ['request', 'confirmed', 'preinvoice', 'rejected', 'accepted', 'warehouse', 'production', 'ready', 'shipped', 'delivered', 'returned', 'cancelled']));
      allow update: if hasRole(['manager', 'ceo', 'sales_manager', 'visitor', 'account_manager'])
        && request.resource.data.keys().hasOnly(['stage', 'updatedAt']) && request.resource.data.updatedAt is number
        && request.resource.data.stage in ['request', 'confirmed', 'preinvoice', 'rejected', 'accepted', 'warehouse', 'production', 'ready', 'shipped', 'delivered', 'returned', 'cancelled'];
      allow delete: if salesLead();
    }

    // What the warehouse (operations) or production must prepare: the account manager creates it when an order is routed; the team that
    // owns the route may only mark it ready (their report; the account manager alone moves the order's stage).
    match /fulfilment/{code} {
      allow read: if hasRole(['operations', 'production', 'account_manager', 'manager', 'ceo', 'sales_manager']);
      allow create: if hasRole(['account_manager', 'manager'])
        && request.resource.data.keys().hasOnly(['code', 'orderCode', 'route', 'stage', 'lines', 'customer', 'recipient', 'phone', 'city', 'address', 'ready', 'readyAt', 'readyBy', 'readyByName', 'note', 'updatedAt', 'by', 'byName'])
        && request.resource.data.route in ['warehouse', 'production'] && request.resource.data.lines is list && request.resource.data.lines.size() <= 40;
      allow update: if (hasRole(['account_manager', 'manager'])
          && request.resource.data.keys().hasOnly(['code', 'orderCode', 'route', 'stage', 'lines', 'customer', 'recipient', 'phone', 'city', 'address', 'ready', 'readyAt', 'readyBy', 'readyByName', 'note', 'updatedAt', 'by', 'byName'])
          && request.resource.data.route in ['warehouse', 'production'])
        || (((hasRole(['operations']) && resource.data.route == 'warehouse') || (hasRole(['production']) && resource.data.route == 'production'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready', 'readyAt', 'readyBy', 'readyByName', 'note', 'updatedAt']));
      allow delete: if hasRole(['account_manager', 'manager']);
    }

    match /prices/{uid} {
      allow read, write: if approved() && request.auth.uid == uid;
    }
  }
}
